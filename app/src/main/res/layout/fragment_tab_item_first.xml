<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/main_form">

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingStart="12dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="100dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/tarDetailsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/detailed_report_logo_background"
            android:elevation="4dp"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:background="@drawable/detailed_report_logo_background"
                    android:elevation="2dp"
                    android:outlineProvider="background">

                    <ImageView
                        android:id="@+id/TARPhoto"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_margin="8dp"
                        android:contentDescription="@string/tar_photo_primary"
                        android:scaleType="fitCenter"
                        app:srcCompat="@mipmap/merchik_m" />
                </FrameLayout>

                <FrameLayout
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/detailed_report_logo_background"
                    android:elevation="2dp"
                    android:outlineProvider="background">

                    <ImageView
                        android:id="@+id/TARPhoto2"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_margin="8dp"
                        android:contentDescription="@string/tar_photo_secondary"
                        android:scaleType="fitCenter"
                        app:srcCompat="@mipmap/merchik_m" />
                </FrameLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/text_data"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="@color/colorDescription"
                android:textSize="16sp"
                tools:text="Завдання" />

            <TextView
                android:id="@+id/textView60"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Оценка задачи:"
                android:textColor="@color/colorDescription"
                android:textStyle="bold"
                android:visibility="gone" />

            <RatingBar
                android:id="@+id/ratingBar2"
                style="?android:attr/ratingBarStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:isIndicator="false"
                android:numStars="9"
                android:visibility="gone" />

            <TextView
                android:id="@+id/textView61"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Оценка объективности:"
                android:textColor="@color/colorDescription"
                android:textStyle="bold" />

            <RatingBar
                android:id="@+id/ratingBar4"
                style="?android:attr/ratingBarStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:isIndicator="false"
                android:numStars="9" />

            <TextView
                android:id="@+id/wpLink"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:clickable="true"
                android:visibility="gone" />

            <TextView
                android:id="@+id/lastComment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="#E6EDCB"
                android:padding="8dp"
                android:clickable="true"
                android:textColor="@color/colorDescription"
                android:visibility="gone" />

            <FrameLayout
                android:id="@+id/tar_visit_map_container"
                android:layout_width="match_parent"
                android:layout_height="350dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/border_map"
                android:elevation="3dp"
                android:padding="8dp"
                android:visibility="gone">

                <androidx.compose.ui.platform.ComposeView
                    android:id="@+id/tar_visit_map"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/border_imgview" />
            </FrameLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:backgroundTint="#FFFFFF"
        app:elevation="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:srcCompat="@drawable/ic_question_1"
        tools:visibility="invisible" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:translationZ="8dp"
        app:backgroundTint="#FFFFFF"
        app:elevation="5dp"
        app:layout_constraintBottom_toTopOf="@id/fab"
        app:layout_constraintEnd_toEndOf="parent"
        app:maxImageSize="57dp"
        app:srcCompat="@drawable/ic_play_circle_solid" />

    <ua.com.merchik.merchik.Utils.Ui.CounterBadgeView
        android:id="@+id/badge_text_view_tar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:alpha="0.8"
        android:text="0"
        android:textColor="#FFFFFF"
        android:translationZ="8dp"
        app:layout_constraintEnd_toEndOf="@id/fab3"
        app:layout_constraintTop_toTopOf="@id/fab3" />
</androidx.constraintlayout.widget.ConstraintLayout>
