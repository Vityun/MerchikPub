<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>

        <!-- Цвет отмеченного CheckBox -->
        <item name="colorControlActivated">@color/blue</item>

        <!-- Цвет неотмеченного CheckBox -->
        <item name="colorControlNormal">@color/hintColorDefault</item>
    </style>

    <style name="AppTheme.FullScreen" >
        <item name="windowActionBar">true</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.Light">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!--Дефолтная тема для меню-->
    <style name="DefaultTheme" parent="Theme.AppCompat.Light">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!--Тема для меню Зелёная (Если есть инет и серв)-->
    <style name="OverlayPrimaryColorGreen">
        <item name="colorPrimary">@color/colorInetGreen</item>
        <!--        <item name="greenCol">@color/colorInetGreen</item>-->
        <item name="colorPrimaryDark">@color/colorInetGreenDark</item>
    </style>

    <!--Тема для меню Жёлтая (Если есть инет а серва нет)-->
    <style name="OverlayPrimaryColorYellow">
        <item name="colorPrimary">@color/colorInetYellow</item>
        <item name="colorPrimaryDark">@color/colorInetYellowDark</item>
    </style>

    <!--Тема для меню Красная (Если нет инета)-->
    <style name="OverlayPrimaryColorRed">
        <item name="colorPrimary">@color/colorInetRed</item>
        <item name="colorPrimaryDark">@color/colorInetRedDark</item>
    </style>

    <style name="MyDialogTheme" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="android:background">@color/colorInetRed</item>
    </style>

    <style name="AppTheme.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />
    <style name="AppTheme.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />

    <style name="TabStyle" parent="Widget.Design.TabLayout">
        <item name="tabIndicatorColor">#0000FF00</item>
        <item name="tabTextAppearance">@style/TextStyleTab</item>
        <item name="tabBackground">@drawable/tab_background_selector</item>
    </style>

    <style name="TextStyleTab">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@drawable/tab_text_selector</item>
    </style>

    <!-- Match the Compose tabs in WpDataTabsScreen without changing other legacy screens. -->
    <style name="DetailedReportTabStyle" parent="Widget.Design.TabLayout">
        <item name="android:background">@color/colorUnselectedTab</item>
        <item name="android:elevation">0dp</item>
        <item name="tabBackground">@drawable/detailed_report_tab_background</item>
        <item name="tabIndicatorColor">@android:color/transparent</item>
        <item name="tabIndicatorHeight">0dp</item>
        <item name="tabTextAppearance">@style/DetailedReportTabTextAppearance</item>
        <item name="tabTextColor">@color/detailed_report_tab_text</item>
        <item name="tabRippleColor">#1F444444</item>
        <item name="tabMode">fixed</item>
        <item name="tabGravity">fill</item>
        <item name="tabMinWidth">0dp</item>
        <item name="tabPaddingStart">4dp</item>
        <item name="tabPaddingEnd">4dp</item>
        <item name="tabPaddingTop">4dp</item>
        <item name="tabPaddingBottom">4dp</item>
    </style>

    <style name="DetailedReportTabTextAppearance" parent="TextAppearance.AppCompat.Button">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/detailed_report_tab_text</item>
    </style>

    <style name="TextShadow">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@drawable/tab_text_selector</item>
        <item name="android:shadowColor">#F0F0F0</item>
        <item name="android:shadowDx">2</item>
        <item name="android:shadowDy">2</item>
        <item name="android:shadowRadius">1</item>
    </style>

    <!--    &lt;!&ndash; Base application theme &ndash;&gt;-->
    <!--    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">-->
    <!--        &lt;!&ndash; Customize your theme here &ndash;&gt;-->
    <!--    </style>-->

    <!-- Transparent theme -->
    <style name="TransparentTheme" parent="AppTheme.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@color/gray_50</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
    </style>

</resources>
